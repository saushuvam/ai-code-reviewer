# Required: Google Gemini API key (https://aistudio.google.com/apikey)
GOOGLE_GEMINI_KEY=your_gemini_api_key_here

# Optional: Gemini model configuration (defaults to gemini-3.5-flash)
# Supported options include gemini-3.5-flash, gemini-3.8-flash, etc.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: Redis connection string. If unset or unreachable, caching is
# silently disabled and the app runs normally (just without the speedup).
REDIS_URL=redis://localhost:6379

# Optional: GitHub personal access token. Without it, GitHub repo/PR review
# is still fully functional but limited to 60 unauthenticated requests/hour.
# With a token (no special scopes needed for public repos): 5000 requests/hour.
GITHUB_TOKEN=
